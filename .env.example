# Copy to .env.local and fill in. .env.local is gitignored.

# The tour's voice (gpt-live-1) and the model behind it. Use a key from an
# OpenAI project of its own, with a monthly budget set on that project — that
# limit is the one thing that holds even if everything in this repo is wrong.
OPENAI_API_KEY=

# Matches each spoken sentence to a photo and a mood. https://console.typesafe.ai
TYPESAFE_API_KEY=

# Signs the cookie that unlocks the tour. 32+ random characters:
#   openssl rand -base64 48
TOUR_SESSION_SECRET=

# Where access codes and their used time are kept (Upstash Redis, REST API).
# Required in production. Left empty in development, codes live in memory and
# the one below is the only code there is.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Who may take the tour, written in Notion: one row per person, with their
# code and what PIP should know about them (see src/lib/tour/server/notion.ts
# for the columns, and `npm run tour:notion -- setup` to create the table).
# NOTION_TOKEN is an internal integration's secret from
# https://www.notion.so/profile/integrations — the table has to be shared
# with that integration. NOTION_VISITORS_DB is the table's id. Optional: left
# empty, codes come only from `npm run tour:codes`.
NOTION_TOKEN=
NOTION_VISITORS_DB=
# What PIP knows about Shreyas, written on a Notion page instead of in
# src/lib/tour/server/context.ts (`npm run tour:notion -- story <page>` makes
# the page, starting from what is in the code). Everything on the page is the
# story. Optional: left empty, the story in the code is used.
NOTION_STORY_PAGE=

# Development only: an access code that works without a store.
TOUR_DEV_CODE=
# Development only: who that code is for, to try the personal greeting.
TOUR_DEV_NAME=
TOUR_DEV_NOTE=
# Photo ids from src/data/tour-images.ts, comma-separated.
TOUR_DEV_PHOTOS=
