# Copy to .env.local and fill in. .env.local is gitignored.

# The tour's voice (gpt-live-1) and the model behind it. Use a key from an
# OpenAI project of its own, with a monthly budget set on that project — that
# limit is the one thing that holds even if everything in this repo is wrong.
OPENAI_API_KEY=

# Matches each spoken sentence to a photo and a mood. https://console.typesafe.ai
TYPESAFE_API_KEY=

# Signs the cookie that unlocks the tour. 32+ random characters:
#   openssl rand -base64 48
TOUR_SESSION_SECRET=

# Where access codes and their used time are kept (Upstash Redis, REST API).
# Required in production. Left empty in development, codes live in memory and
# the one below is the only code there is.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Development only: an access code that works without a store.
TOUR_DEV_CODE=
# Development only: who that code is for, to try the personal greeting.
TOUR_DEV_NAME=
TOUR_DEV_NOTE=
# Photo ids from src/data/tour-images.ts, comma-separated.
TOUR_DEV_PHOTOS=
